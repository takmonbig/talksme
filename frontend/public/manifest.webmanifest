{
  "name": "talksme.in — Chats",
  "short_name": "talksme",
  "description": "One inbox for all your business conversations.",
  "id": "/chat",
  "start_url": "/chat",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "related_applications": [{ "platform": "webapp", "url": "https://talksme.in/manifest.webmanifest" }],
  "scope": "/",
  "display": "standalone",
  "background_color": "#F8FAFC",
  "theme_color": "#0284C7",
  "icons": [
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any maskable" },
    { "src": "/favicon-32x32.png", "sizes": "32x32", "type": "image/png" }
  ]
}
